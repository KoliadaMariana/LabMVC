@model IEnumerable<RecipeBookMVC.Models.Recipe>

@{
    ViewData["Title"] = "Asystent Lodówki Premium";
    var availableIngredients = ViewBag.AvailableIngredients as List<string> ?? new List<string>();
    var selectedIngredients = ViewBag.SelectedIngredients as List<string> ?? new List<string>();
}

<div class="container mt-4">
    <div class="p-4 text-white rounded-4 mb-4 shadow-sm"
         style="background: linear-gradient(135deg, #1E110A 0%, #3A2312 100%);">
        <div class="d-flex align-items-center">
            <div class="p-3 bg-warning text-dark rounded-circle me-3">
                <i class="bi bi-gem fs-3"></i>
            </div>
            <div>
                <h2 class="fw-bold mb-1" style="color: #FFF7ED;">Inteligentny Asystent Lodówki</h2>
                <p class="text-white-50 mb-0">Zaznacz składniki, które masz w domu, a Smakolyk podpowie Ci, co możesz z
                    nich przygotować!</p>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card border-0 shadow-sm rounded-4 p-4" style="background-color: #FAF6F0;">
                    <h5 class="fw-bold mb-3" style="color: #3A2312;"><i class="bi bi-pantry me-2"></i> Twoja Spiżarnia</h5>
                
                    <form asp-action="Pantry" method="get">
                        <div class="mb-4">
                            @foreach (var ingredient in availableIngredients)
                            {
                                var isChecked = selectedIngredients.Contains(ingredient) ? "checked" : null;
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="selectedIngredients"
                                           value="@ingredient" id="check-@ingredient" @isChecked>
                                    <label class="form-check-label fw-medium text-dark" for="check-@ingredient">
                                        @ingredient
                                    </label>
                                </div>
                            }
                        </div>
                    
                        <button type="submit" class="btn w-100 fw-bold text-white shadow-sm"
                                style="background-color: #E28743; border-radius: 10px;">
                            <i class="bi bi-lightning-charge-fill me-1"></i> Dopasuj przepis
                        </button>
                        <a asp-action="Pantry" class="btn btn-outline-secondary w-100 mt-2 fw-semibold"
                               style="border-radius: 10px;">
                            Resetuj filtry
                        </a>
                    </form>
                </div>
            </div>

            <div class="col-md-8">
                <h4 class="fw-bold mb-3" style="color: #3A2312;">Sugerowane Przepisy</h4>

                @if (Model == null || !Model.Any())
                {
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center" style="background-color: #FAF6F0;">
                        <i class="bi bi-clipboard-x display-4 text-muted mb-3"></i>
                        <h5 class="text-dark fw-bold">Brak dopasowań</h5>
                        <p class="text-muted small">Wybierz składniki z panelu po lewej stronie, aby dopasować przepisy.</p>
                    </div>
                }
                else
                {
                    <div class="row g-3">
                        @foreach (var item in Model)
                        {
                            <div class="col-sm-6">
                                <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative"
                                     style="background-color: #FAF6F0;">
                                    <div class="card-body p-4">
                                        <span class="badge position-absolute top-0 end-0 m-3"
                                              style="background-color: #E28743;">@item.Difficulty</span>
                                        <h5 class="card-title fw-bold text-dark mt-2 mb-1">@item.Name</h5>
                                        <p class="text-muted small mb-3"><i class="bi bi-clock me-1"></i> Czas: @item.CookingTime
                                            min</p>
                                            <div
                                                class="d-flex justify-content-end align-items-center mt-auto pt-2 border-top border-light">
                                                <a asp-action="Details" asp-route-id="@item.Id"
                                                       class="btn btn-sm fw-bold text-white px-3"
                                                       style="background-color: #3A2312; border-radius: 6px;">
                                                    Zobacz
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>