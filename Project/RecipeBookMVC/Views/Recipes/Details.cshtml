@model RecipeBookMVC.Models.Recipe

@{
    ViewData["Title"] = Model.Name;
}

<div class="container mt-4 mb-5">
    <a asp-action="Index" class="btn btn-link text-decoration-none text-muted mb-4 p-0">
        <i class="bi bi-arrow-left"></i> Powrót do listy
    </a>

    <div class="row g-5">
        <div class="col-md-5">
            <div class="sticky-top" style="top: 2rem;">
                <img src="@Model.ImageUrl" class="img-fluid rounded-5 shadow-lg mb-4" alt="@Model.Name">

                <div class="p-4 rounded-4" style="background-color: #Fdfbf9; border: 1px solid #eee;">
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <i class="bi bi-clock-history d-block fs-3 mb-1" style="color: #E28743;"></i>
                            <span class="fw-bold">@Model.CookingTime min</span>
                        </div>
                        <div class="border-start border-end px-4">
                            <i class="bi bi-bar-chart-line d-block fs-3 mb-1" style="color: #E28743;"></i>
                            <span class="fw-bold">@Model.Difficulty</span>
                        </div>
                        <div>
                            <i class="bi bi-tag d-block fs-3 mb-1" style="color: #E28743;"></i>
                            <span class="fw-bold">@Model.Category?.Name</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <h1 class="display-4 fw-bold mb-2" style="color: #1E110A; font-family: 'Playfair Display', serif;">
                @Model.Name</h1>
                <p class="text-muted mb-4">Autor: <span class="fw-bold text-dark">@(Model.User?.FirstName ?? "Szef Kuchni")</span></p>

                <div class="mb-5">
                    <h3 class="fw-bold mb-3" style="border-left: 4px solid #E28743; padding-left: 15px;">Składniki</h3>
                    <ul class="list-group list-group-flush">
                        @foreach (var ingredient in Model.Ingredients.Split(','))
                        {
                            <li class="list-group-item bg-transparent border-0 ps-0">
                                <i class="bi bi-dot text-warning fs-4"></i> @ingredient.Trim()
                            </li>
                        }
                    </ul>
                </div>

                <div>
                    <h3 class="fw-bold mb-3" style="border-left: 4px solid #3C2A21; padding-left: 15px;">Przygotowanie</h3>
                    <div class="lh-lg" style="white-space: pre-line; color: #444; font-size: 1.1rem;">
                        @Model.Instructions
                    </div>
                </div>
            </div>
        </div>
    </div>