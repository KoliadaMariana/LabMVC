@model IEnumerable<RecipeBookMVC.Models.Recipe>
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

@{
    ViewData["Title"] = "Przepisy";
    // Отримуємо ID поточного користувача один раз на початку сторінки
    var currentUserId = UserManager.GetUserId(User);
}

<div class="container mt-4">
    @* Блок із заголовком та кнопкою додавання *@
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold" style="color: #3E2723; margin: 0;">📖 Książka Kucharska</h1>

        <a asp-action="Create" class="btn text-white px-4 py-2"
           style="background-color:  #3E2723; border-radius: 10px; font-weight: 500; border: none;">
            + Dodaj Nowy Przepis
        </a>
    </div>

    @* Панель фільтрації (бежева, з шоколадною кнопкою) *@
    <div class="card shadow-sm border-0 mb-5 p-4"
         style="background-color: #F9F3EB; border: 1px solid #E3D5C8 !important; border-radius: 15px;">
        <form asp-action="Index" method="get" class="row g-3">
            <div class="col-md-5">
                <label class="form-label fw-bold" style="color: #3E2723;">Szukaj po nazwie</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0" style="border-radius: 8px 0 0 8px;">
                        <i class="bi bi-search"></i>
                    </span>
                    <input type="text" name="searchString" class="form-control border-start-0"
                           style="border-radius: 0 8px 8px 0;" placeholder="np. Kurczak, Brownie..." />
                </div>
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold" style="color: #3E2723;">Kategoria</label>
                <select name="category" class="form-select" style="border-radius: 8px;">
                    <option value="">Wszystkie kategorie</option>
                    @if (ViewData["Categories"] != null)
                    {
                        @foreach (var cat in (List<string>)ViewData["Categories"]!)
                        {
                            <option value="@cat">@cat</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex align-items-end gap-2">
                <button type="submit" class="btn w-100 fw-bold"
                        style="background-color: #3E2723; color: white; border-radius: 8px; border: none;">
                    Filtruj
                </button>
                <a asp-action="Index" class="btn btn-outline-dark"
                   style="border-radius: 8px; border-color: #3E2723; color: #3E2723;">Reset</a>
            </div>
        </form>
    </div>

    @* Сітка з картками рецептів *@
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0"
                     style="border-radius: 15px; overflow: hidden; background-color: white;">
                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                    {
                        <img src="@item.ImageUrl" class="card-img-top" alt="@item.Name"
                             style="height: 220px; object-fit: cover;">
                    }
                    <div class="card-body d-flex flex-column p-4">
                        <div class="mb-2">
                            <span class="badge px-2 py-1"
                                  style="background-color: #D29062; color: white; border-radius: 5px;">
                                @item.Category?.Name
                            </span>
                            <span class="text-muted small ms-2"><i class="bi bi-clock"></i> @item.CookingTime min</span>
                        </div>

                        <h5 class="card-title fw-bold" style="color: #3E2723;">@item.Name</h5>
                        <p class="card-text text-muted small flex-grow-1">@item.Ingredients</p>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                            <span class="small text-muted">
                                <i class="bi bi-person"></i> @(item.User?.FirstName ?? "Mariana")
                            </span>

                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm px-3"
                                   style="border-color: #3E2723; color: #3E2723; border-radius: 8px; font-weight: 500;">
                                    Zobacz przepis
                                </a>

                                @* КНОПКА ВИДАЛЕННЯ: показується тільки якщо поточний користувач є автором *@
                                @if (item.UserId == currentUserId && !string.IsNullOrEmpty(currentUserId))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger px-3"
                                       style="border-radius: 8px; font-weight: 500;">
                                        <i class="bi bi-trash"></i> Usuń
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        transition: all 0.2s;
    }
</style>