@model IEnumerable<RecipeBookMVC.Models.Recipe>

@{
    ViewData["Title"] = "Moja lodówka";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center mb-4">
            <h1 class="fw-bold" style="color: #3C2A21;"><i class="bi bi-snow2 me-2"></i>Inteligentna Lodówka</h1>
            <p class="text-muted">Wpisz składniki, które masz w domu (oddzielając je przecinkami), a my znajdziemy
                przepis!</p>
            </div>
        </div>

        <div class="row justify-content-center mb-5">
            <div class="col-md-6">
                <form asp-controller="Fridge" asp-action="SearchRecipes" method="post"
                      class="shadow-sm p-4 bg-light rounded-3" style="border: 1px solid #D4A373;">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-bold" style="color: #5C4033;">Co masz w lodówce?</label>
                        <input type="text" name="ingredientsInput" class="form-control"
                               placeholder="np. mleko, jajka, kurczak" value="@ViewBag.IngredientsQuery"
                               style="border-radius: 10px;" required />
                    </div>

                    <button type="submit" class="btn w-100 text-white fw-bold"
                            style="background-color: #3C2A21; border-radius: 10px;">
                        Szukaj przepisów
                    </button>
                </form>
            </div>
        </div>

        <div class="row">
            @if (Model != null && Model.Any())
            {
                <h3 class="fw-bold mb-4 text-center" style="color: #3C2A21;">Propozycje dań dla Ciebie:</h3>
                @foreach (var recipe in Model)
                {
                    <div class="col-md-4 mb-4">
                        <div class="card h-100 border-0 shadow-sm" style="border-radius: 15px; overflow: hidden;">
                            <img src="@recipe.ImageUrl" class="card-img-top" alt="@recipe.Name"
                                 style="height: 200px; object-fit: cover; background-color: #FAF6F0;">
                            <div class="card-body p-4">
                                <span class="badge mb-2 text-white" style="background-color: #E28743;">@recipe.Category?.Name</span>
                                <h5 class="card-title fw-bold">@recipe.Name</h5>
                                <p class="card-text text-muted small text-truncate">@recipe.Ingredients</p>
                                <p class="card-text small"><strong>Czas:</strong> @recipe.CookingTime min |
                                    <strong>Trudność:</strong> @recipe.Difficulty
                                </p>
                            </div>
                        </div>
                    </div>
                }
            }
            else if (ViewBag.IngredientsQuery != null)
            {
                <div class="col-10 text-center mx-auto">
                    <div class="alert alert-warning" style="border-radius: 10px;">
                        Nie znaleźliśmy żadnych przepisów pasujących do podanych składników. Spróbuj wpisać coś innego!
                    </div>
                </div>
            }
        </div>
    </div>