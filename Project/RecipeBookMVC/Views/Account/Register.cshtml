@{
    ViewData["Title"] = "Rejestracja";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0"
                 style="background-color: #FAF6F0; border-radius: 15px; box-shadow: 0 4px 15px rgba(0,0,0,0.05)!important;">
                <div class="card-body p-5">
                    <h2 class="fw-bold text-center mb-4" style="color: #3C2A21; font-family: 'Poppins', sans-serif;">
                        Utwórz nowe konto</h2>

                        <form action="/Account/Register" method="post">
                            @Html.AntiForgeryToken()

                            <div class="text-danger mb-3" asp-validation-summary="All"></div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" style="color: #5C4033; font-weight: 500;">Imię</label>
                                    <input name="firstName" type="text" class="form-control"
                                           style="border-color: #D4A373; background-color: #FFF;" required />
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label class="form-label" style="color: #5C4033; font-weight: 500;">Nazwisko</label>
                                    <input name="lastName" type="text" class="form-control"
                                           style="border-color: #D4A373; background-color: #FFF;" required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" style="color: #5C4033; font-weight: 500;">Adres e-mail</label>
                                <input name="email" type="email" class="form-control"
                                       style="border-color: #D4A373; background-color: #FFF;" required />
                            </div>

                            <div class="mb-4">
                                <label class="form-label" style="color: #5C4033; font-weight: 500;">Hasło</label>
                                <input name="password" type="password" class="form-control"
                                       style="border-color: #D4A373; background-color: #FFF;" required />
                            </div>

                            <button type="submit" class="btn w-100 text-white fw-bold py-2"
                                    style="background-color: #E28743; border-radius: 8px; border: none; font-size: 16px;">
                                Zarejestruj się
                            </button>
                        </form>

                        <div class="text-center mt-4 border-top pt-3" style="border-color: #E7DEC8 !important;">
                            <p style="color: #5C4033; margin: 0;">Masz już konto? <a href="/Account/Login"
                                                                                         style="color: #3C2A21; font-weight: bold; text-decoration: none;">Zaloguj się</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>